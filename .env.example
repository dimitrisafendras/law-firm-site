# ---------------------------------------------------------------------------
# Supabase configuration
#
# Copy this file to `.env.local` (git-ignored) for local development, or use
# `.env.staging` together with `vite --mode staging` / `vite build --mode staging`.
#
# WHY THESE ARE SAFE TO EXPOSE
# Anything prefixed with VITE_ is inlined into the client bundle at build time
# and is therefore public. The Supabase *publishable* key is designed for that:
# it identifies the project, it does not grant privileges. The real security
# boundary is Row Level Security on the database. Never put a service-role key,
# a database password, or any other secret in a VITE_ variable.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — public by design, protected by RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
